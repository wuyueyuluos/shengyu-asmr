            </intent-filter>
        </activity>
        <receiver android:name="androidx.media.session.MediaButtonReceiver" android:exported="true"><intent-filter><action android:name="android.intent.action.MEDIA_BUTTON" /></intent-filter></receiver>\n    </application>
